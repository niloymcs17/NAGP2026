								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/employees/team",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"employees",
								"team"
							]
						},
						"description": "Retrieve the list of employees reporting to the logged-in manager."
					},
					"response": []
				},
				{
					"name": "Create Employee (Manager Only)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"id\": 4,\n    \"username\": \"employee3\",\n    \"fullName\": \"Employee Three\",\n    \"email\": \"employee3@company.com\",\n    \"role\": \"EMPLOYEE\",\n    \"managerId\": 3\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/employees",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"employees"
							]
						},
						"description": "Create a new employee profile. Only manager can call this. Triggers RabbitMQ event and initializes leave balances in Leave Service."
					},
					"response": []
				}
			]
		}
